<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Authors>Anders Giske Hagen</Authors>
    <Copyright>Copyright © 2026 Anders Giske Hagen</Copyright>
    <RepositoryUrl>https://github.com/ezspot/cs2-statscollector</RepositoryUrl>
    <PackageProjectUrl>https://github.com/ezspot/cs2-statscollector</PackageProjectUrl>
    <Company>Anders 'spot' Hagen</Company>
    <Description>Comprehensive CS2 stats collection to MySQL</Description>
    <Version>1.0.0</Version>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- The test project lives under tests/; keep its sources out of the plugin's default compile glob. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="statsCollector.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Microsoft.Extensions.* and Serilog come transitively from CounterStrikeSharp.API: CSS loads its own
         copies of those at runtime (shared types), so compile against exactly those versions. ExcludeAssets keeps
         the host's assemblies out of the plugin folder: on an older core a private CounterStrikeSharp.API copy
         there is loaded instead and the plugin is reported as "Unable to find plugin in assembly". -->
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.379" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Extensions.ObjectPool" Version="10.0.14" />
    <PackageReference Include="Polly.Extensions" Version="8.9.0" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="Dapper" Version="2.1.89" />
  </ItemGroup>
  
  <ItemGroup>
    <None Update="cfg\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded so AutoCreateSchema can apply it at runtime without shipping a loose file. -->
    <EmbeddedResource Include="database\init.sql" />
  </ItemGroup>
</Project>
